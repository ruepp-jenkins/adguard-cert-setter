{
  "name": "adguard-cert-setter",
  "version": "1.0.0",
  "description": "Distribute TLS certificates to all configured AdGuard Home instances.",
  "homepage": "https://github.com/ruepp-jenkins/adguard-cert-setter",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruepp-jenkins/adguard-cert-setter.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup src/server/main.ts src/server/cli.ts --format esm --target node22 --out-dir dist/server --clean --sourcemap",
    "start": "node dist/server/main.js",
    "hash-password": "tsx src/server/cli.ts hash-password",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "pino": "^9.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
