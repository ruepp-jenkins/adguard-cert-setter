APP_USERNAME=admin
# Generate with `docker run --rm -it ruepp/adguard-cert-setter:latest node dist/server/cli.js hash-password`.
# Keep the generated hash single-quoted so Docker Compose treats its dollar signs literally.
APP_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$INSERT_HASH_HERE'
APP_PORT=3000
APP_COOKIE_SECURE=false
